# Ganglion runtime environment.
# Copied to ~/.ganglion/ganglion.env by deploy/setup-server.sh and loaded by the
# systemd unit's EnvironmentFile=. Keep the live copy mode 600. Never commit the
# filled-in version — only this example is tracked.

PORT=3000

# Under systemd, $SHELL is usually unset; server.js falls back to /bin/bash, but
# set it explicitly so spawned tabs are predictable.
SHELL=/bin/bash

NODE_ENV=production

# --- Distiller: OFF for launch. DO NOT enable yet. --------------------------------
# distiller.js:297 hardcodes ~/.npm-global/bin/claude, which does NOT exist on this
# box (the global install lands in /usr/bin/claude). Enabling this without fixing
# that path first will throw ENOENT. Fix the path (resolve claude from PATH, or
# symlink ~/.npm-global/bin/claude -> $(command -v claude)) before setting this to 1.
# GANGLION_DISTILL_ENABLED=0
# GANGLION_DISTILL_MODEL=haiku

# --- GANGLION_VAULT: no effect on the running server. -----------------------------
# The server's vault watcher keys off a HARDCODED ~/Documents/TheBrainOfChris
# (index-vault.js), not this variable — so on EC2 it simply no-ops (path absent).
# This var only affects the standalone `npm run memory:index-vault` CLI.
# GANGLION_VAULT=
