# Ganglion runtime environment.
# Copied to ~/.ganglion/ganglion.env by deploy/setup-server.sh and loaded by the
# systemd unit's EnvironmentFile=. Keep the live copy mode 600. Never commit the
# filled-in version — only this example is tracked.

PORT=3000

# Under systemd, $SHELL is usually unset; server.js falls back to /bin/bash, but
# set it explicitly so spawned tabs are predictable.
SHELL=/bin/bash

NODE_ENV=production

# --- Distiller (session notes) ---------------------------------------------------
# Off unless set to 1. It runs headless `claude -p`; the binary is GANGLION_CLAUDE_BIN,
# else ~/.local/bin/claude (where the native installer puts it). Set it explicitly:
# the systemd service's PATH may not include ~/.local/bin.
# GANGLION_CLAUDE_BIN=/home/ubuntu/.local/bin/claude
# GANGLION_DISTILL_ENABLED=0
# GANGLION_DISTILL_MODEL=haiku

# --- GANGLION_VAULT: the Obsidian vault indexed into Ctrl+K recall ---------------
# Default ~/TheBrainOfChris. Used by the server (boot sweep + watcher), the
# `npm run memory:index-vault` CLI and `npm run memory:import`.
# GANGLION_VAULT=

# Minutes a session must be quiet before its note is written (default 10).
# GANGLION_DISTILL_IDLE_MIN=10

# --- Phone alerts (ntfy) -----------------------------------------------------------
# Off unless GANGLION_NTFY_URL is set. Pushes to your phone when a tab has been red
# (waiting for you) for the delay, or a run of at least DONE_MIN minutes finishes.
# Use a long random topic: anyone who knows a public ntfy.sh topic can read it.
# Install the ntfy app on the phone and subscribe to the same topic.
# GANGLION_NTFY_URL=https://ntfy.sh/ganglion-<random>
# GANGLION_NTFY_TOKEN=            # only for a protected/self-hosted ntfy
# GANGLION_ALERT_CLICK_URL=http://stigmergylabs.tailc44383.ts.net:3000
# GANGLION_ALERT_DELAY_SEC=30     # skip the alert if you answer within this
# GANGLION_ALERT_DONE_MIN=5       # 0 = no "finished" alerts

# --- Boot sweep of stale tab signal files in /tmp ---------------------------------
# Production only. Removes ganglion-<tab>-status|tool|ingest files for tabs no longer in
# state.json and untouched for a day. Never set this for a second/scratch instance: it
# shares /tmp with the live server and would delete the live tabs' files.
GANGLION_SWEEP_SIGNALS=1
