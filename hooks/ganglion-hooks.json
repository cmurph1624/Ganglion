{
  "_comment": "GANGLION_SIGNAL is replaced with an absolute path by setup-hooks.js. Every event routes through one Node handler that shares lib/platform.js with server.js, so the writer and reader of the signal files cannot disagree about their location. The previous POSIX shell one-liners (printf, [ -n ... ], python3) could not run on Windows.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GANGLION_SIGNAL SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GANGLION_SIGNAL UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "GANGLION_SIGNAL PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "GANGLION_SIGNAL PostToolUse"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GANGLION_SIGNAL Notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GANGLION_SIGNAL Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GANGLION_SIGNAL SessionEnd"
          }
        ]
      }
    ]
  }
}
